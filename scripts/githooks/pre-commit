#!/bin/sh
# Docs Harness pre-commit：docs/plans 文档卫生强制检查（全量扫描，秒级）。
# 结构不具备（无 scripts/harness.py 或 docs/plans）时静默放行；
# python 不可用时不锁死提交，但打印醒目警告。

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -f "$ROOT/scripts/harness.py" ] || exit 0
[ -d "$ROOT/docs/plans" ] || exit 0
cd "$ROOT" || exit 0

if command -v python >/dev/null 2>&1; then
    PYTHON_BIN=python
elif command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN=python3
else
    echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" >&2
    echo "!! WARNING: 未找到 python/python3，已跳过 docs-check 检查 !!" >&2
    echo "!! docs/plans 文档卫生未验证，请尽快补跑：                  !!" >&2
    echo "!!   python scripts/harness.py docs-check                   !!" >&2
    echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" >&2
    exit 0
fi

OUTPUT=$("$PYTHON_BIN" scripts/harness.py docs-check --target . 2>&1)
CODE=$?
if [ "$CODE" -ne 0 ]; then
    echo "$OUTPUT" >&2
    echo "pre-commit: docs-check 未通过（exit=$CODE），提交已中止" >&2
    exit 1
fi
exit 0
