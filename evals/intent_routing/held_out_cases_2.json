{
  "schema_version": "docs-harness/intent-routing-eval/v1",
  "dataset_version": "held-out-2",
  "split": "held_out_2",
  "purpose": "第二组 50 条全新用例，只验证强力模型直路由；不运行 rules/Jev 对照，不根据结果调题。",
  "labels": {
    "intents": [
      "answer_only",
      "code_task",
      "bug_fix",
      "plan_decision",
      "asset_lifecycle",
      "release",
      "docs_change"
    ],
    "modules": [
      "code",
      "bugfix",
      "docs",
      "plan",
      "assets",
      "release"
    ],
    "triggers": [
      "read_only",
      "code_edit",
      "code_verify",
      "bug_report",
      "plan_required",
      "asset_operation",
      "release",
      "docs_edit",
      "direct_override",
      "clarify_required"
    ]
  },
  "intent_modules": {
    "answer_only": [],
    "code_task": ["code"],
    "bug_fix": ["code", "bugfix"],
    "plan_decision": ["plan"],
    "asset_lifecycle": ["assets"],
    "release": ["release"],
    "docs_change": ["docs"]
  },
