{
  "schema_version": "docs-harness/intent-routing-eval/v1",
  "dataset_version": "held-out-1",
  "split": "held_out",
  "purpose": "50 条未参与 v2 调词的新用例，用于验证 rules-v1 与 Jev 1.14.0 的泛化；看过结果后本组即视为已消费，不再在本组上调阈值。",
  "labels": {
    "intents": [
      "answer_only",
      "code_task",
      "bug_fix",
      "plan_decision",
      "asset_lifecycle",
      "release",
      "docs_change"
    ],
    "modules": [
      "code",
      "bugfix",
      "docs",
      "plan",
      "assets",
      "release"
    ],
    "triggers": [
      "read_only",
      "code_edit",
      "code_verify",
      "bug_report",
      "plan_required",
      "asset_operation",
      "release",
      "docs_edit",
      "direct_override",
      "clarify_required"
    ]
  },
  "intent_modules": {
    "answer_only": [],
    "code_task": ["code"],
    "bug_fix": ["code", "bugfix"],
    "plan_decision": ["plan"],
    "asset_lifecycle": ["assets"],
    "release": ["release"],
    "docs_change": ["docs"]
  },
  "cases": [
